{
  "name": "safe",
  "description": "Best default for spoken-word cleanup when natural delivery matters and over-processing should be controlled.",
  "notes": [
    "This is the default preset for natural-language calls.",
    "It balances DeepFilterNet cleanup with conservative gating and loudness control."
  ],
  "extract": {
    "sample_rate": 48000,
    "channels": 1,
    "pcm_codec": "pcm_s16le"
  },
  "deepfilternet": {
    "enabled": true,
    "module": "df.enhance",
    "post_filter": true
  },
  "filters": {
    "highpass_hz": 70,
    "lowpass_hz": 12000,
    "secondary_denoise": {
      "enabled": true,
      "nr": 10,
      "nf": -26,
      "tracking": true
    },
    "gate": {
      "enabled": true,
      "threshold": 0.018,
      "ratio": 2.5,
      "attack_ms": 15,
      "release_ms": 220,
      "makeup_db": 0
    },
    "compressor": {
      "enabled": true,
      "threshold_db": -18,
      "ratio": 2.0,
      "attack_ms": 12,
      "release_ms": 140,
      "makeup_db": 2
    },
    "loudnorm": {
      "target_i": -16.0,
      "target_lra": 7.0,
      "target_tp": -1.5
    }
  },
  "analysis": {
    "silence_candidates": false,
    "silence_threshold_db": -38,
    "silence_min_duration": 0.12
  },
  "transcript_export": {
    "codec": "libmp3lame",
    "bitrate": "192k"
  }
}
