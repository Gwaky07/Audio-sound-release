{
  "name": "clarity-leveling-safe",
  "description": "Safe auto-candidate: clarity EQ and gentle leveling without low-pass, gates, hard mutes, or model denoise.",
  "notes": [
    "Whitelist auto candidate only. No DeepFilterNet, Respiro, SpectraMini, gate, or hard mute.",
    "Clarity bands stay moderate so articulation and air are preserved against the source baseline."
  ],
  "pipeline": {
    "stages": [
      {
        "type": "respiro",
        "enabled": false,
        "threshold": 0.064,
        "min_length_ms": 20
      },
      {
        "type": "spectramini",
        "enabled": false,
        "breath_control_reduction": 0.0,
        "breath_control_sensitivity": 0.0,
        "mouth_declick_sensitivity": 0.0
      },
      {
        "type": "deepfilternet",
        "enabled": false,
        "module": "df.enhance",
        "post_filter": false
      }
    ]
  },
  "extract": {
    "sample_rate": 48000,
    "channels": 1,
    "pcm_codec": "pcm_s16le"
  },
  "filters": {
    "highpass_hz": 55,
    "lowpass_hz": null,
    "equalizer": {
      "enabled": true,
      "bands": [
        {
          "frequency_hz": 250,
          "width_type": "q",
          "width": 1.0,
          "gain_db": -0.5
        },
        {
          "frequency_hz": 3200,
          "width_type": "q",
          "width": 1.0,
          "gain_db": 1.0
        },
        {
          "frequency_hz": 7500,
          "width_type": "q",
          "width": 0.8,
          "gain_db": 0.5
        }
      ]
    },
    "secondary_denoise": {
      "enabled": false,
      "nr": 4,
      "nf": -55,
      "tracking": false
    },
    "declick": {
      "enabled": false,
      "window": 55,
      "overlap": 75,
      "arorder": 2,
      "threshold": 2.2,
      "burst": 2.0
    },
    "nonlinear_denoise": {
      "enabled": false,
      "strength": 0.01,
      "patch": 0.002,
      "research": 0.006,
      "smooth": 11
    },
    "deesser": {
      "enabled": false,
      "intensity": 0.06,
      "max_deessing": 0.2,
      "frequency": 0.46
    },
    "gate": {
      "enabled": false,
      "threshold": 0.01,
      "ratio": 1.2,
      "attack_ms": 25,
      "release_ms": 300,
      "makeup_db": 0
    },
    "compressor": {
      "enabled": true,
      "threshold_db": -18,
      "ratio": 1.35,
      "attack_ms": 25,
      "release_ms": 250,
      "makeup_db": 0
    },
    "speech_norm": {
      "enabled": false,
      "expansion": 1.0,
      "raise": 0.0005,
      "fall": 0.0005,
      "threshold": 0.0
    },
    "breath_onset_cleanup": {
      "enabled": false
    },
    "pause_residual_cleanup": {
      "enabled": false
    },
    "loudnorm": {
      "target_i": -19.0,
      "target_lra": 9.0,
      "target_tp": -3.0
    }
  },
  "analysis": {
    "silence_candidates": false,
    "silence_threshold_db": -40,
    "silence_min_duration": 0.15
  },
  "transcript_export": {
    "codec": "libmp3lame",
    "bitrate": "192k"
  }
}
