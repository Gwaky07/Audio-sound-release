{
  "name": "natural",
  "description": "Natural-first spoken-word delivery that preserves articulation and uses only conservative mastering by default.",
  "notes": [
    "This is the default final-delivery preset when clarity and naturalness are more important than maximum noise removal.",
    "Automatic breath removal, adaptive denoise, hard gating, and automatic pause muting are disabled.",
    "Use review, voice-isolate, or exact repair windows only after the specific defect has been verified."
  ],
  "pipeline": {
    "stages": [
      {
        "type": "respiro",
        "enabled": false,
        "threshold": 0.064,
        "min_length_ms": 20
      },
      {
        "type": "spectramini",
        "enabled": false,
        "breath_control_reduction": 0.0,
        "breath_control_sensitivity": 0.0,
        "mouth_declick_sensitivity": 0.0
      },
      {
        "type": "deepfilternet",
        "enabled": false,
        "module": "df.enhance",
        "post_filter": false
      }
    ]
  },
  "extract": {
    "sample_rate": 48000,
    "channels": 1,
    "pcm_codec": "pcm_s16le"
  },
  "filters": {
    "highpass_hz": 55,
    "lowpass_hz": null,
    "stereo_balance": {
      "enabled": true,
      "min_imbalance_db": 1.5,
      "max_channel_gain_db": 12.0,
      "target": "louder",
      "correlation_trigger": 0.85,
      "mismatch_mode": "dual_mono_louder",
      "decorrelated_mode": "dual_mono_louder",
      "mid_blend_when_decorrelated": 0.0
    },
    "secondary_denoise": {
      "enabled": false,
      "nr": 6,
      "nf": -32,
      "tracking": false
    },
    "declick": {
      "enabled": false,
      "window": 55,
      "overlap": 75,
      "arorder": 2,
      "threshold": 2.2,
      "burst": 2.0
    },
    "nonlinear_denoise": {
      "enabled": false,
      "strength": 0.01,
      "patch": 0.002,
      "research": 0.006,
      "smooth": 11
    },
    "deesser": {
      "enabled": false,
      "intensity": 0.08,
      "max_deessing": 0.3,
      "frequency": 0.46
    },
    "gate": {
      "enabled": false,
      "threshold": 0.01,
      "ratio": 1.2,
      "attack_ms": 25,
      "release_ms": 300,
      "makeup_db": 0
    },
    "compressor": {
      "enabled": true,
      "threshold_db": -16,
      "ratio": 1.25,
      "attack_ms": 30,
      "release_ms": 300,
      "makeup_db": 0
    },
    "speech_norm": {
      "enabled": false,
      "expansion": 1.0,
      "raise": 0.0005,
      "fall": 0.0005,
      "threshold": 0.0
    },
    "breath_onset_cleanup": {
      "enabled": false
    },
    "pause_residual_cleanup": {
      "enabled": false
    },
    "loudnorm": {
      "target_i": -19.0,
      "target_lra": 11.0,
      "target_tp": -3.0
    }
  },
  "analysis": {
    "silence_candidates": false,
    "silence_threshold_db": -40,
    "silence_min_duration": 0.15
  },
  "transcript_export": {
    "codec": "libmp3lame",
    "bitrate": "192k"
  }
}
